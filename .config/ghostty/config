# https://terminalcolors.com/themes/ayu/dark/
background = #0b0e14
foreground = #bfbdb6
selection-background = #1b3a5b
selection-foreground = #bfbdb6
cursor-color = #bfbdb6
cursor-text = #0b0e14
palette = 0=#1e232b
palette = 1=#ea6c73
palette = 2=#7fd962
palette = 3=#f9af4f
palette = 4=#53bdfa
palette = 5=#cda1fa
palette = 6=#90e1c6
palette = 7=#c7c7c7
palette = 8=#686868
palette = 9=#f07178
palette = 10=#aad94c
palette = 11=#ffb454
palette = 12=#59c2ff
palette = 13=#d2a6ff
palette = 14=#95e6cb
palette = 15=#ffffff

# https://omp.sh/docs/quickstart
keybind = alt+backspace=text:\x1b\x7f
keybind = shift+enter=text:\n
keybind = performable:ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+tab=next_tab
keybind = shift+ctrl+tab=previous_tab
keybind = shift+ctrl+left=move_tab:-1
keybind = shift+ctrl+right=move_tab:1
keybind = ctrl+t=new_tab
